@model List<IGLESIA_MIDTERM_STORE.Models.Product>
@{ ViewData["Title"] = "Products"; }

<h1>Products</h1>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
           placeholder="Search product name..." />

    <button type="submit">Search</button>

    <a asp-action="Index">Clear</a>
</form>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>

<div class="row">
  @foreach (var p in Model)
  {
    <div class="col-md-4 mb-4">
      <div class="card" style="width: 18rem;">
        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name">
        <div class="card-body">
          <h5 class="card-title">@p.Name</h5>
          <p class="card-text">@p.Description</p>
          <p class="card-text"><strong>Price:</strong> @p.Price</p>
          <p class="card-text"><strong>Category:</strong> @p.Category</p>

          <a asp-action="Edit"
             asp-route-id="@p.Id"
             class="btn btn-warning">Edit</a>

          <a asp-action="Delete"
             asp-route-id="@p.Id"
             class="btn btn-danger"
             onclick="return confirm('Delete this product?')">Delete</a>

          <a asp-action="AddToCart"
             asp-route-id="@p.Id"
             class="btn btn-success">Add to Cart</a>
        </div>
      </div>
    </div>
  }
</div>