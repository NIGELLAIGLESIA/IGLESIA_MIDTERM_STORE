@model List<IGLESIA_MIDTERM_STORE.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>My Cart ⋆</h1>

<table class="table table-bordered rounded-4 overflow-hidden">
    <thead>
        <tr>
            <th class="fw-semibold p-3">Product Name</th>
            <th class="fw-semibold p-3">Price</th>
            <th class="fw-semibold p-3">Quantity</th>
            <th class="fw-semibold p-3">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="p-3">@item.ProductName</td>
                <td class="p-3">@item.Price</td>
                <td class="p-3">
                    <form asp-action="Update" method="post">
                        <input type="hidden" name="id" value="@item.Id" />

                        <input type="number"
                               name="quantity"
                               value="@item.Quantity"
                               min="1" />

                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill">
                            Update
                        </button>
                    </form>
                </td>

                <td class="p-3">
                    <a asp-action="Remove"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-secondary btn-sm rounded-pill">
                        Remove
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h3 class="mb-3">
    Total: @Model.Sum(item => item.Price * item.Quantity)
</h3>

<a asp-controller="Products"
   asp-action="Index"
   class="btn bg-white border border-danger-subtle rounded-pill">
    Continue Shopping
</a>