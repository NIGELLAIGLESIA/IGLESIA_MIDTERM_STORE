@model List<IGLESIA_MIDTERM_STORE.Models.Product>
@{ ViewData["Title"] = "Products"; }

<h1>Products</h1>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
           placeholder="Search product name..." />

    <button type="submit">Search</button>

    <a asp-action="Index">Clear</a>
</form>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>

<div class="row">
  @foreach (var p in Model)
  {
    <div class="col-md-4 mb-4">
    <div class="card h-100 shadow-sm rounded-4">
        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name">
        <div class="card-body">
          <h5 class="card-title fw-semibold">@p.Name</h5>
          <p class="card-text"><strong>ID:</strong> @p.Id</p>
          <p class="card-text">@p.Description</p>
          <p class="card-text fw-semibold">₱@p.Price</p>
          <span class="badge text-bg-light rounded-pill mb-3">@p.Category</span>

 <div class="d-flex gap-2">

          <a asp-action="Edit"
          asp-route-id="@p.Id"
          class="btn btn-warning-subtle btn-sm rounded-pill">Edit</a>

          <a asp-action="Delete"
          asp-route-id="@p.Id"
          class="btn btn-danger-subtle btn-sm rounded-pill"
          onclick="return confirm('Delete this product?')">Delete</a>

<a asp-action="AddToCart"
   asp-route-id="@p.Id"
   class="btn btn-success-subtle btn-sm rounded-pill">Add to Cart</a>
   </div>
        </div>
      </div>
    </div>
  }
</div>